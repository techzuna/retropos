// GENERATED by packages/db/compose.mjs — do not edit.
// Models live in packages/db/models.prisma; only the datasource differs.
//
// SQLite: a single file on the restaurant's own machine, so service
// continues when the internet does not.
//
// No enums, arrays or native types anywhere in the models: that started as a
// SQLite limitation and is now the contract that lets both providers share
// one schema. Constrained values are strings validated by Zod at the edges.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  backupFrequency String    @default("daily") // off | daily | weekly
  backupRetention Int       @default(30) // files kept
  lastBackupAt    DateTime?
  createdAt       DateTime  @default(now())

  outlets Outlet[]
  users   User[]
}

model Outlet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String       @default("")
  phone          String       @default("")
  currency       String       @default("NPR") // ISO 4217, for menu/bill display
  timezone       String       @default("UTC") // IANA; owner sets it per outlet (report day-bucketing + booking windows)
  qrImagePath    String       @default("") // payment QR upload under data/uploads; "" = none
  active         Boolean      @default(true)

  tables         DiningTable[]
  menuCategories MenuCategory[]
  modifiers      Modifier[]
  servicePeriods ServicePeriod[]
  orders         Order[]
  users          User[]
  reservations   Reservation[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outletId       String? // null = owner (all outlets); staff/manager pinned to one
  outlet         Outlet?      @relation(fields: [outletId], references: [id])
  name           String
  email          String?      @unique // owner/manager login; staff may have none
  passwordHash   String? // bcrypt; null for PIN-only staff
  pinHash        String? // bcrypt of 4-digit PIN; floor-device switching
  role           String       @default("staff") // owner | manager | staff
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  openedOrders  Order[] @relation("openedBy")
  settledOrders Order[] @relation("settledBy")
  reservations  Reservation[]
}

model DiningTable {
  id        String  @id @default(cuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int     @default(2) // seats — the party size this table takes
  zone      String  @default("") // where it stands: Floor, Courtyard, Loft, Corridor… free text per outlet
  shape     String  @default("rect") // round | square | rect — drawn as a seat diagram on booking cards
  sortOrder Int     @default(0)
  active    Boolean @default(true) // retired tables leave the board but keep their history

  orders       Order[]
  reservations Reservation[]
}

model MenuCategory {
  id        String  @id @default(cuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  published Boolean @default(true)

  items MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  priceCents  Int // outlet currency minor units
  imagePath   String       @default("") // upload under data/uploads; "" = show a placeholder
  available   Boolean      @default(true) // the "86" toggle
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)

  orderItems OrderItem[]
  modifiers  MenuItemModifier[]
}

/**
 * A priced add-on, held per outlet and reused across items — "Bacon +4.00",
 * "Double salad +7.00", "Large portion +7.00".
 *
 * Outlet-level rather than per-item on purpose: the same extras recur across a
 * menu, and the ordering screen shows the outlet's whole list on every card so
 * the rows sit in the same place each time. Which ones a given item actually
 * offers is the `MenuItemModifier` allow-list; the rest render disabled.
 */
model Modifier {
  id         String  @id @default(cuid())
  outletId   String
  outlet     Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int // may be 0 for a free option
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  items      MenuItemModifier[]
  orderLines OrderItemModifier[]

  @@unique([outletId, name])
}

/** Which extras an item offers. Absent = shown disabled on the order screen. */
model MenuItemModifier {
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierId String
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([menuItemId, modifierId])
  @@index([modifierId])
}

/**
 * An extra chosen on one order line, snapshotted at add-time under the same law
 * as `OrderItem`: renaming or repricing a modifier never moves an existing bill.
 */
model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String? // soft pointer; null once the modifier is deleted
  modifier    Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
  name        String // snapshot at add-time
  priceCents  Int // snapshot at add-time, per unit of the line

  @@index([orderItemId])
}

model Order {
  id            String    @id @default(cuid())
  outletId      String
  outlet        Outlet    @relation(fields: [outletId], references: [id])
  tableId       String
  table         DiningTable @relation(fields: [tableId], references: [id])
  customerName  String    @default("Anonymous Customer")
  guestCount    Int?
  status        String    @default("open") // open | settled | cancelled
  paymentMethod String? // qr | cash; null until settled
  totalCents    Int       @default(0) // 0 while open; frozen at settle
  openedById    String
  openedBy      User      @relation("openedBy", fields: [openedById], references: [id])
  settledById   String?
  settledBy     User?     @relation("settledBy", fields: [settledById], references: [id])
  openedAt      DateTime  @default(now())
  settledAt     DateTime?

  items       OrderItem[]
  reservation Reservation? // set when this order was opened from a booking

  @@index([outletId, status])
  @@index([outletId, settledAt])
  @@index([tableId, status])
}

/**
 * A named stretch of the trading day — Breakfast, Lunch, Dinner — configured per
 * outlet.
 *
 * Bookings are taken against one of these rather than a clock time: a
 * restaurant can't promise a table at 19:15, but it can promise dinner. The
 * wall-clock window is what turns a period into the UTC hold a booking stores,
 * so all the overlap and board logic is unchanged underneath.
 */
model ServicePeriod {
  id        String  @id @default(cuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name      String
  startTime String // "HH:MM" wall clock in the outlet's timezone
  endTime   String // "HH:MM", later than startTime on the same day
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  reservations Reservation[]

  @@unique([outletId, name])
}

/**
 * A future claim on a table — a booking a host took by phone or at the door.
 *
 * Deliberately NOT a status column on DiningTable: occupancy stays derived from
 * an open order, and "reserved" is derived from these rows overlapping a given
 * instant. A table can therefore be reserved for 19:00 and still be occupied by
 * a walk-in right now, which is exactly what happens in a real service.
 *
 * `startAt`/`endAt` are UTC instants; the host enters a local date and window,
 * and the outlet's timezone converts at the edge. Half-open [start, end) so
 * back-to-back bookings (18:00–20:00, 20:00–22:00) don't collide.
 */
model Reservation {
  id           String      @id @default(cuid())
  outletId     String
  outlet       Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tableId      String
  table        DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName String
  phone        String      @default("")
  email        String      @default("")
  partySize    Int
  startAt      DateTime // UTC
  endAt        DateTime // UTC, exclusive
  allDay          Boolean        @default(false) // held for the whole outlet-local day
  servicePeriodId String? // soft pointer; null for an all-day hold or a retired period
  servicePeriod   ServicePeriod? @relation(fields: [servicePeriodId], references: [id], onDelete: SetNull)
  periodLabel     String         @default("") // snapshot: "Dinner". Renaming a period never rewrites history
  // incoming (taken, not yet confirmed) → confirmed → seated, or cancelled /
  // no_show. "Completed" is NOT stored: it is derived from the linked order
  // being settled, so the booking card can never disagree with the bill.
  status       String      @default("confirmed")
  notes        String      @default("") // "birthday", "window seat", "arriving late"
  orderId      String?     @unique // the order this booking became, once seated
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([outletId, startAt])
  @@index([tableId, status, startAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String? // soft pointer; null once the menu item is deleted
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String // snapshot at add-time — bills are immutable history
  priceCents Int // snapshot at add-time, base item only; extras add on top
  quantity   Int
  notes      String    @default("")
  addedAt    DateTime  @default(now())

  modifiers OrderItemModifier[]

  @@index([orderId])
}
