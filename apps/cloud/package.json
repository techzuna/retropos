{
  "name": "@restro/cloud",
  "version": "0.1.0",
  "private": true,
  "//": "The hosted multi-tenant service: one Postgres, many restaurants, every row scoped by organizationId. Deploys anywhere that runs Node — no native database driver, so none of the glibc and ABI trouble the self-hosted build has to survive.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@restro/domain": "*",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
